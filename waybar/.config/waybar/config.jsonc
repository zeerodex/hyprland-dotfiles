{
  // -------------------------------------------------------------------------
  // General Waybar Configuration
  // -------------------------------------------------------------------------
  "layer": "top",
  "height": 21,
  "spacing": 0,
  "margin-top": 5,
  "margin-right": 5,
  "margin-left": 5,
  // -------------------------------------------------------------------------
  // Module Placement
  // -------------------------------------------------------------------------
  "modules-left": [
    "group/left"
  ],
  "modules-center": [
  ],
  "modules-right": [
    "group/right"
  ],
  // -------------------------------------------------------------------------
  // Module Configuration
  // -------------------------------------------------------------------------
  // Clock Module

  "group/tray" :{
    "orientation": "horizontal",
    "modules": ["custom/tray-icon", "tray"],
    "drawer": {
        "transition-duration": 500,
        "children-class": "not-power",
        "transition-left-to-right": true,
    },
  },

  "custom/tray-icon": {
    "format":""
  },

  "group/left" :{
    "orientation": "horizontal",
    "modules": ["hyprland/workspaces", "custom/spotify" , "wireplumber#source", "wireplumber","idle_inhibitor" ,"group/tray"],
  },

  "group/right" : {
    "orientation": "horizontal",
    "modules" : ["cpu", "temperature", "memory", "hyprland/language", "clock"],
  },

  "clock": {
    "format": "  {:%A %Y-%m-%d %H:%M:%S}",
    "tooltip": true,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "on-click-right": "gsimplecal",
    "interval": 1
  },
  // CPU Module
  "cpu": {
    "format": "  {usage}%",
    "tooltip": true,
    "tooltip-format": "CPU Usage: {usage}%",
    "interval": 2
  },
  // Custom Media Player
  "custom/spotify": {
    "format": " {}",
    "return-type": "json",
    "max-length": 50,
    "exec": "playerctl -a metadata -p spotify --format '{\"text\": \"{{artist}} - {{title}}\", \"tooltip\": \"{{playerName}}: {{artist}} - {{title}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
    "on-click": "playerctl -p spotify play-pause",
    "on-click-right": "playerctl -p spotify next",
    "on-click-middle": "playerctl -p spotify previous",
    "on-scroll-up": "playerctl -p spotify volume 0.05+",
    "on-scroll-down": "playerctl -p spotify volume 0.05-",
    "escape": true,
    "tooltip": true
  },
  // Custom Power Button
  "custom/power-button": {
    "format": " ",
    "on-click": "~/.config/rofi/powermenu/type-2/powermenu.sh",
    "tooltip": false
  },
  // Disk Module
  "disk": {
    "format": " 󰣆  {free}",
    "interval": 20
  },
  // Hyprland Language Module
  "hyprland/language": {
    "format": "  {}",
    "format-en": "Enlish",
    "format-ru": "Russian",
    "format-uk": "Ukrainian"
  },
  "hyprland/workspaces": {
  "format": "{icon}",
  "on-click": "activate",
  "on-scroll-up": "hyprctl dispatch workspace e+1",
  "on-scroll-down": "hyprctl dispatch workspace e-1",
  "format-icons": {
      "1": "1",
      "2": "2",
      "3": "3",
      "4": "󰈙 ",
      "5": "󰊖 ",
      "6": " ",
      "7": "7",
      "8": "8",
      "9": "9",
      "10": "10",
      "code": " ",
      "browser": " ",
    "urgent": "",
    "default": ""
  },
  "sort-by-number": true
  },
  // Idle Inhibitor Module
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": " ",
      "deactivated": " "
    }
  },
  // Memory Module
  "memory": {
    "format": "  {used} GiB ({percentage}%)",
    "tooltip": false,
    "interval": 10,
    "on-click-right": "kitty -e btop"
  },
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 ",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip-format": "{desc} - {volume}%",
    "scroll-step": 1,
  },
  "wireplumber#source": {
    "node-type": "Audio/Source",
    "format": "󰍬",
    "format-muted": "󰍭",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "true",
    "on-scroll-down": "true",
    "scroll-step": 5,
},
  
  // Temperature Module
  "temperature": {
    "tooltip": false,
    "hwmon-path": "/sys/devices/platform/nct6775.656/hwmon/hwmon4/temp2_input",
    "critical-threshold": 70,
    "interval": 2,
    "format": "  {temperatureC}°C",
    "format-critical": "  {temperatureC}°C"
  },
  // System Tray Module
  "tray": {
    "icon-size": 12,
    "spacing": 7
  }
}
