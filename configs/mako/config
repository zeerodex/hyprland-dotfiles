# GLOBAL
#sort=+time
layer=overlay

# STYLE
font=JetBrains Mono Nerd Font 10
margin=20
padding=5, 5, 5, 5
border-size=2
border-radius=10
background-color=#eff1f5
border-color=#9ca0b0
text-color=#4c4f69
default-timeout=2500
max-icon-size=125
icon-path=/usr/share/icons/Papirus/
icon-location=left
format=<b>%s</b>\n%b
text-alignment=left
anchor=top-right

# CRITERA
## urgency
[urgency=low]
default-timeout=2500
background-color=#eff1f5
border-color=#bcc0cc
text-color=#4c4f69

[urgency=normal]
default-timeout=2500
background-color=#eff1f5
border-color=#5c5f77
text-color=#4c4f69


[urgency=critical]
default-timeout=5000
background-color=#eff1f5
border-color=#cba6f7
text-color=#4c4f69



